{
  "permissions": {
    "allow": [
      "Edit(*)",
      "Write(*)",
      "Bash(task test)",
      "Bash(task test:*)",
      "Bash(task lint)",
      "Bash(task format)",
      "Bash(task test-coverage)",
      "Bash(task frontend:check)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go test *)",
      "Bash(npm run test)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(git *)",
      "Bash(gh *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; case \"$f\" in *.go) gofmt -w \"$f\" ;; esac; } 2>/dev/null || true",
            "statusMessage": "Formatting..."
          }
        ]
      }
    ]
  }
}
